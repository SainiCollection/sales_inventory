# Ignore node_modules and build output
node_modules/
build/
dist/
.env
.DS_Store
coverage/
*.log

# Ignore editor and OS files
.vscode/
*.swp
*.swo
*.tmp
*.bak

# Allow source and config files
!src/
!public/
!package.json
!package-lock.json
!yarn.lock
!.gitignore
!README.md
!tsconfig.json
!jsconfig.json
!babel.config.js
!webpack.config.js
!vite.config.js
!next.config.js
!postcss.config.js
!tailwind.config.js
!*.md
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
